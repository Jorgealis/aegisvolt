# npm run dev -- --mode test
# URL de API Gateway del ambiente test: existe solo con enable_platform = true.
# Obtenerla con:  cd infra; terraform workspace select test; terraform output -raw graphql_url
# y ponerla en .env.test.local (no se versiona) o abrir la app con ?api=<url>.
VITE_GRAPHQL_URL=http://localhost:8080/graphql
