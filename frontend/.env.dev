# npm run dev -- --mode dev
# URL de API Gateway del ambiente dev: existe solo con enable_platform = true.
# Obtenerla con:  cd infra; terraform workspace select dev; terraform output -raw graphql_url
# y ponerla en .env.dev.local (no se versiona) o abrir la app con ?api=<url>.
VITE_GRAPHQL_URL=http://localhost:8080/graphql
