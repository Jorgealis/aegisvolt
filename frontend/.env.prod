# npm run dev -- --mode prod
# URL de API Gateway del ambiente prod: existe solo con enable_platform = true.
# Obtenerla con:  cd infra; terraform workspace select prod; terraform output -raw graphql_url
# y ponerla en .env.prod.local (no se versiona) o abrir la app con ?api=<url>.
VITE_GRAPHQL_URL=http://localhost:8080/graphql
